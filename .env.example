DB_URL=jdbc:mysql://localhost:3307/portfolio_db?serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=1800000

APP_OAUTH2_REDIRECT_URL=http://localhost:3000/
APP_OAUTH2_FAILURE_URL=http://localhost:3000/
APP_AUTH_COOKIE_NAME=PORTPICK_ACCESS_TOKEN
APP_AUTH_COOKIE_SECURE=false
# 프론트와 백엔드 도메인이 다르면 None (Secure 자동 적용)
APP_AUTH_COOKIE_SAME_SITE=Lax
# 쉼표로 여러 개 지정 가능
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
